# Copy this file to .env and fill in your values.

# Server
PORT=3000

# How long (in minutes) to collect bids before auto-selecting the lowest one,
# when the job is submitted during business hours.
BID_WINDOW_MINUTES=30

# Business hours (24hr clock, server's local time). If a job comes in outside
# this window, the bidding window instead runs until 1 hour after the next
# opening time, so a small pro network still gets a fair chance to see it.
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=18

# Soft close: if a bid comes in within this many minutes of the window
# closing, push the close out by this many minutes — so a late bid on a
# small network doesn't get cut off before others can respond.
SOFT_CLOSE_THRESHOLD_MINUTES=5
SOFT_CLOSE_EXTENSION_MINUTES=5

# Twilio (https://www.twilio.com/console)
# Leave these blank to run in DEV MODE, where outgoing texts are printed
# to the server console instead of actually sent — useful for testing
# the flow before you have a Twilio account.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

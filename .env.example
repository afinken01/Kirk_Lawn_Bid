# Copy this file to .env and fill in your values.

# Server
PORT=3000

# How long (in minutes) to collect bids before auto-selecting the lowest one,
# when the job is submitted during business hours.
BID_WINDOW_MINUTES=30

# Business hours (24hr clock, server's local time). If a job comes in outside
# this window, the bidding window instead runs until 1 hour after the next
# opening time, so a small pro network still gets a fair chance to see it.
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=18

# Soft close: if a bid comes in within this many minutes of the window
# closing, push the close out by this many minutes — so a late bid on a
# small network doesn't get cut off before others can respond.
SOFT_CLOSE_THRESHOLD_MINUTES=5
SOFT_CLOSE_EXTENSION_MINUTES=5

# How long the homeowner has to reply Y (accept) or N (cancel) once a bid is
# selected, before the job is automatically cancelled. Default 120 (2 hours).
CONFIRMATION_WINDOW_MINUTES=120

# Admin dashboard login (HTTP Basic Auth). Required — admin access is
# refused entirely if ADMIN_PASSWORD isn't set, rather than left open.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Twilio (https://www.twilio.com/console)
# Leave these blank to run in DEV MODE, where outgoing texts are printed
# to the server console instead of actually sent — useful for testing
# the flow before you have a Twilio account.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional: put a QR code for the network fee in the winning pro's text.
# PAYMENT_LINK_TEMPLATE must contain {amount} — it gets replaced with the
# fee amount for that job. Both PayPal.me and Cash App support pre-filled
# amounts in the URL; Venmo's web links don't reliably support this.
#   PayPal:    https://paypal.me/YourName/{amount}
#   Cash App:  https://cash.app/$YourCashtag/{amount}
# PUBLIC_BASE_URL is your live domain (e.g. https://kirkwoodlawnfinder.com)
# — required alongside PAYMENT_LINK_TEMPLATE, since Twilio fetches the QR
# image itself and can't reach localhost or a relative path. Leave both
# blank to skip the QR code entirely — the fee is still mentioned in the text.
PAYMENT_LINK_TEMPLATE=
PUBLIC_BASE_URL=
